# Serial port for the myCobot280 arm
MYCOBOT_PORT=/dev/ttyAMA0

# Baud rate (default: 1000000)
MYCOBOT_BAUD=1000000

# Allowed CORS origins (comma-separated, or "*" for all)
# Only matters for browser pages on another origin calling the REST API; /sim is same-origin
MYCOBOT_CORS_ORIGINS=*

# Password for the IK simulator, /ws/arm and the REST API (sent as the X-Arm-Password header).
# If empty, the backend makes up a random one at startup and prints it.
MYCOBOT_PASSWORD=

# Inverse kinematics engine: native (the built-in solver, fast enough for the Pi), pink (Pink on Pinocchio,
# ~5x slower, 64-bit OS only: pip install pin-pink daqp) or ikpy (IKPy, ~25x slower). run.sh asks, and
# installs the one you pick; everything around it (collision checks, routes) is the same.
MYCOBOT_IK=native
